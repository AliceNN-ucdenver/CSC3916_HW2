# JWT signing secret - MUST be ≥32 characters, cryptographically random
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=your_secret_key_min_32_chars_change_in_production

# Application identifier returned in movie responses
UNIQUE_KEY=your_unique_key

# Pre-seeded test user credentials (used by Basic auth and tests)
DEFAULT_USER=defaultUser
DEFAULT_PASSWORD=defaultPassword123!

# Server configuration
PORT=3000
