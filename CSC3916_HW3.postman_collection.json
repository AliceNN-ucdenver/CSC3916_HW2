{
  "info": {
    "name": "CSC3916 HW3 - REST API with Auth",
    "description": "Comprehensive Postman collection testing JWT/Basic auth, movies CRUD, and error scenarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "jwt_token",
      "value": "",
      "type": "default"
    },
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "POST /signup (Create user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has success property\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "pm.test(\"Response has message\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"postmanuser\",\n    \"password\": \"postmanPass123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/signup",
          "host": ["{{base_url}}"],
          "path": ["signup"]
        }
      }
    },
    {
      "name": "POST /signin (Get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has token\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.collectionVariables.set('jwt_token', jsonData.token);",
              "});",
              "",
              "pm.test(\"Response has success property\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"defaultUser\",\n    \"password\": \"defaultPassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/signin",
          "host": ["{{base_url}}"],
          "path": ["signin"]
        }
      }
    },
    {
      "name": "GET /movies (Public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has correct message\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('GET movies');",
              "});",
              "",
              "pm.test(\"Response has headers, query, and env\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.headers).to.exist;",
              "    pm.expect(jsonData.query).to.exist;",
              "    pm.expect(jsonData.env).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/movies?genre=action",
          "host": ["{{base_url}}"],
          "path": ["movies"],
          "query": [
            {
              "key": "genre",
              "value": "action"
            }
          ]
        }
      }
    },
    {
      "name": "POST /movies (Public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has correct message\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('movie saved');",
              "});",
              "",
              "pm.test(\"Response has headers, query, and env\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.headers).to.exist;",
              "    pm.expect(jsonData.query).to.exist;",
              "    pm.expect(jsonData.env).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Test Movie\",\n    \"year\": 2024\n}"
        },
        "url": {
          "raw": "{{base_url}}/movies",
          "host": ["{{base_url}}"],
          "path": ["movies"]
        }
      }
    },
    {
      "name": "PUT /movies (With JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has correct message\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('movie updated');",
              "});",
              "",
              "pm.test(\"Response has headers, query, and env\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.headers).to.exist;",
              "    pm.expect(jsonData.query).to.exist;",
              "    pm.expect(jsonData.env).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Updated Movie\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/movies",
          "host": ["{{base_url}}"],
          "path": ["movies"]
        }
      }
    },
    {
      "name": "PUT /movies without token (Failing scenario)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Should Fail\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/movies",
          "host": ["{{base_url}}"],
          "path": ["movies"]
        }
      }
    },
    {
      "name": "DELETE /movies (With Basic Auth)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has correct message\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('movie deleted');",
              "});",
              "",
              "pm.test(\"Response has headers, query, and env\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.headers).to.exist;",
              "    pm.expect(jsonData.query).to.exist;",
              "    pm.expect(jsonData.env).to.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "defaultUser",
              "type": "string"
            },
            {
              "key": "password",
              "value": "defaultPassword123!",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/movies",
          "host": ["{{base_url}}"],
          "path": ["movies"]
        }
      }
    },
    {
      "name": "DELETE /movies wrong password (Failing scenario)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "defaultUser",
              "type": "string"
            },
            {
              "key": "password",
              "value": "wrongPassword",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/movies",
          "host": ["{{base_url}}"],
          "path": ["movies"]
        }
      }
    },
    {
      "name": "PATCH /movies (Unsupported method)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 405\", function () {",
              "    pm.response.to.have.status(405);",
              "});",
              "",
              "pm.test(\"Response has correct message\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('HTTP method not supported');",
              "});",
              "",
              "pm.test(\"Allow header is present\", function () {",
              "    pm.response.to.have.header('Allow');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Patch Movie\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/movies",
          "host": ["{{base_url}}"],
          "path": ["movies"]
        }
      }
    }
  ]
}
